<%- include('partials/header') %>

<h2 class="mb-4"><i class="bi bi-bar-chart me-2"></i>Standings</h2>

<% if (rows.length === 0) { %>
<div class="alert alert-info">
  <i class="bi bi-info-circle me-2"></i>No brackets have been created yet. Be the first to <a href="/register" class="alert-link">register</a> and create a bracket!
</div>
<% } else { %>
<div class="card shadow-sm">
  <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
    <h5 class="mb-0"><i class="bi bi-list-ol me-2"></i>All Brackets</h5>
    <small class="text-muted">Sorted by total points</small>
  </div>
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th style="width:50px">#</th>
          <th><i class="bi bi-person me-1"></i>Player</th>
          <th><i class="bi bi-bookmark me-1"></i>Bracket</th>
          <th class="text-center"><i class="bi bi-table me-1"></i>Group Pts</th>
          <th class="text-center"><i class="bi bi-diagram-3 me-1"></i>Knockout Pts</th>
          <th class="text-center fw-bold">Total</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach((row, idx) => { %>
        <tr class="<%= idx === 0 ? 'table-warning' : (idx === 1 ? 'table-secondary' : '') %>">
          <td>
            <% if (idx === 0) { %>
              <i class="bi bi-trophy-fill text-warning fs-5"></i>
            <% } else if (idx === 1) { %>
              <i class="bi bi-trophy-fill text-secondary fs-5"></i>
            <% } else if (idx === 2) { %>
              <i class="bi bi-trophy text-danger fs-5"></i>
            <% } else { %>
              <span class="text-muted"><%= idx + 1 %></span>
            <% } %>
          </td>
          <td><strong><%= row.username %></strong></td>
          <td class="text-muted"><%= row.bracket_name %></td>
          <td class="text-center">
            <span class="badge bg-primary"><%= row.groupPoints %></span>
          </td>
          <td class="text-center">
            <span class="badge bg-success"><%= row.knockoutPoints %></span>
          </td>
          <td class="text-center">
            <span class="badge bg-dark fs-6"><%= row.total %></span>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<%- include('partials/footer') %>
