<%- include('partials/header') %>

<div class="row justify-content-center">
  <div class="col-md-5">
    <div class="card shadow-sm">
      <div class="card-header bg-dark text-white">
        <h4 class="mb-0"><i class="bi bi-plus-circle me-2"></i>Create New Bracket</h4>
      </div>
      <div class="card-body p-4">
        <form method="POST" action="/brackets">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="mb-4">
            <label for="name" class="form-label">Bracket Name</label>
            <input type="text" class="form-control" id="name" name="name"
                   required maxlength="100" placeholder="e.g. My Main Picks, Bold Predictions…">
            <div class="form-text">Give your bracket a memorable name.</div>
          </div>
          <button type="submit" class="btn btn-warning w-100 fw-bold">
            <i class="bi bi-check-circle me-2"></i>Create Bracket
          </button>
        </form>
      </div>
      <div class="card-footer text-center">
        <a href="/dashboard" class="text-muted"><i class="bi bi-arrow-left me-1"></i>Back to Dashboard</a>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
