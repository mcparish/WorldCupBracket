<%- include('partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2><i class="bi bi-diagram-3 me-2"></i>Knockout Stage Picks</h2>
    <p class="text-muted mb-0">Bracket: <strong><%= bracket.name %></strong></p>
  </div>
  <a href="/dashboard" class="btn btn-outline-secondary btn-sm">
    <i class="bi bi-arrow-left me-1"></i>Back
  </a>
</div>

<div class="alert alert-info mb-4">
  <i class="bi bi-info-circle me-2"></i>
  Pick the winner for each knockout match. Points: R32=2, R16=4, QF=8, SF=16, Final=32.
</div>

<form method="POST" action="/brackets/<%= bracket.id %>/knockout-picks">
  <% rounds.forEach(round => { %>
  <% if (byRound[round] && byRound[round].length > 0) { %>
  <div class="card shadow-sm mb-4">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
      <h5 class="mb-0">
        <% if (round === 'r32') { %><i class="bi bi-circle me-2"></i>
        <% } else if (round === 'r16') { %><i class="bi bi-circle-half me-2"></i>
        <% } else if (round === 'qf') { %><i class="bi bi-circle-fill me-2 text-warning"></i>
        <% } else if (round === 'sf') { %><i class="bi bi-star me-2 text-warning"></i>
        <% } else { %><i class="bi bi-trophy me-2 text-warning"></i>
        <% } %>
        <%= roundLabels[round] %>
      </h5>
      <% const pts = {r32:2,r16:4,qf:8,sf:16,final:32}; %>
      <span class="badge bg-warning text-dark"><%= pts[round] %> pts per correct pick</span>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th style="width:30px">#</th>
              <th class="text-end">Team 1</th>
              <th class="text-center" style="width:180px">Pick Winner</th>
              <th>Team 2</th>
              <th class="text-center">Result</th>
            </tr>
          </thead>
          <tbody>
            <% byRound[round].forEach((match, i) => { %>
            <tr>
              <td class="text-muted small"><%= match.position %></td>
              <td class="text-end">
                <% if (match.home_team) { %>
                <strong><%= match.home_team %></strong>
                <% } else { %>
                <span class="text-muted fst-italic">TBD</span>
                <% } %>
              </td>
              <td class="text-center">
                <% if (match.home_team_id && match.away_team_id) { %>
                <select class="form-select form-select-sm" name="winner_<%= match.id %>">
                  <option value="">-- Pick Winner --</option>
                  <option value="<%= match.home_team_id %>"
                    <%= match.picked_winner_id === match.home_team_id ? 'selected' : '' %>>
                    <%= match.home_team %>
                  </option>
                  <option value="<%= match.away_team_id %>"
                    <%= match.picked_winner_id === match.away_team_id ? 'selected' : '' %>>
                    <%= match.away_team %>
                  </option>
                </select>
                <% } else { %>
                <span class="text-muted small">Match not set</span>
                <% } %>
              </td>
              <td>
                <% if (match.away_team) { %>
                <strong><%= match.away_team %></strong>
                <% } else { %>
                <span class="text-muted fst-italic">TBD</span>
                <% } %>
              </td>
              <td class="text-center">
                <% if (match.played && match.winner_team) { %>
                  <span class="badge bg-success"><%= match.winner_team %> <i class="bi bi-check-circle ms-1"></i></span>
                <% } else { %>
                  <span class="text-muted small">Pending</span>
                <% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <% } else { %>
  <div class="card shadow-sm mb-4">
    <div class="card-header bg-dark text-white">
      <h5 class="mb-0"><%= roundLabels[round] %></h5>
    </div>
    <div class="card-body">
      <p class="text-muted mb-0"><i class="bi bi-clock me-2"></i>Matchups for this round have not been set yet.</p>
    </div>
  </div>
  <% } %>
  <% }) %>

  <div class="d-flex justify-content-end sticky-bottom bg-white py-3 border-top">
    <button type="submit" class="btn btn-warning btn-lg px-5">
      <i class="bi bi-save me-2"></i>Save Knockout Picks
    </button>
  </div>
</form>

<%- include('partials/footer') %>
