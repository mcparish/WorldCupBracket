<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | 2026 World Cup Picks</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container">
    <a class="navbar-brand fw-bold" href="/">
      <i class="bi bi-trophy-fill text-warning me-2"></i>WC 2026 Picks
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav me-auto">
        <li class="nav-item">
          <a class="nav-link" href="/"><i class="bi bi-house me-1"></i>Home</a>
        </li>
        <% if (session && session.userId) { %>
        <li class="nav-item">
          <a class="nav-link" href="/dashboard"><i class="bi bi-grid me-1"></i>Dashboard</a>
        </li>
        <% } %>
        <li class="nav-item">
          <a class="nav-link" href="/standings"><i class="bi bi-bar-chart me-1"></i>Standings</a>
        </li>
        <% if (session && session.isAdmin) { %>
        <li class="nav-item">
          <a class="nav-link text-warning" href="/admin"><i class="bi bi-shield-lock me-1"></i>Admin</a>
        </li>
        <% } %>
      </ul>
      <ul class="navbar-nav">
        <% if (session && session.userId) { %>
        <li class="nav-item">
          <span class="nav-link text-light"><i class="bi bi-person me-1"></i><%= session.username %></span>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/logout"><i class="bi bi-box-arrow-right me-1"></i>Logout</a>
        </li>
        <% } else { %>
        <li class="nav-item">
          <a class="nav-link" href="/login"><i class="bi bi-box-arrow-in-right me-1"></i>Login</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/register"><i class="bi bi-person-plus me-1"></i>Register</a>
        </li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>

<main class="container py-4">
  <% if (flash) { %>
  <div class="alert alert-<%= flash.type %> alert-dismissible fade show" role="alert">
    <%= flash.message %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
  <% } %>
