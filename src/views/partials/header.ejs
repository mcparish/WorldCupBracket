<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title + ' – ' : '' %>World Cup 2026</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-success">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">⚽ World Cup 2026</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navMenu">
        <ul class="navbar-nav me-auto">
          <li class="nav-item"><a class="nav-link" href="/standings">Standings</a></li>
          <% if (typeof session !== 'undefined' && session.userId) { %>
            <li class="nav-item"><a class="nav-link" href="/dashboard">My Brackets</a></li>
            <% if (session.isAdmin) { %>
              <li class="nav-item"><a class="nav-link" href="/admin">Admin</a></li>
            <% } %>
          <% } %>
        </ul>
        <ul class="navbar-nav">
          <% if (typeof session !== 'undefined' && session.userId) { %>
            <li class="nav-item">
              <span class="nav-link text-light">👤 <%= session.username %></span>
            </li>
            <li class="nav-item">
              <form method="POST" action="/auth/logout" class="d-inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-outline-light btn-sm ms-1" type="submit">Logout</button>
              </form>
            </li>
          <% } else { %>
            <li class="nav-item"><a class="nav-link" href="/auth/login">Login</a></li>
            <li class="nav-item"><a class="nav-link" href="/auth/register">Register</a></li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>
