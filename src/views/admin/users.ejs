<%- include('../partials/header', { title: 'Admin – Users' }) %>
<div class="container py-4">
  <div class="d-flex align-items-center mb-4">
    <a href="/admin" class="btn btn-sm btn-outline-secondary me-3">← Admin</a>
    <h2 class="mb-0">User Management</h2>
  </div>
  <table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
      <tr>
        <th>ID</th><th>Username</th><th>Email</th><th>Admin?</th><th>Registered</th><th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% for (const u of users) { %>
        <tr>
          <td><%= u.id %></td>
          <td><%= u.username %></td>
          <td><%= u.email %></td>
          <td><%= u.is_admin ? '✅' : '—' %></td>
          <td><%= new Date(u.created_at).toLocaleDateString() %></td>
          <td>
            <form method="POST" action="/admin/users/<%= u.id %>/toggle-admin">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-sm <%= u.is_admin ? 'btn-outline-warning' : 'btn-outline-success' %>" type="submit">
                <%= u.is_admin ? 'Remove Admin' : 'Make Admin' %>
              </button>
            </form>
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
